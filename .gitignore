# is commented out by default.
#.vscode/

# Flutter / Dart / Pub
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
pubspec_overrides.yaml
/build/
/coverage/

# Flutter version managers
.fvm/

# Platform-generated ephemeral folders
**/ios/Flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/linux/flutter/ephemeral/
**/windows/flutter/ephemeral/

# Xcode user-specific files
**/ios/**/*.xcuserdatad/
**/ios/**/*.xcworkspace/xcuserdata/
**/macos/**/*.xcuserdatad/
**/macos/**/*.xcworkspace/xcuserdata/

# Android local build cache
**/android/.gradle/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio build artifacts
/android/app/debug
/android/app/profile
/android/app/release

# Environment variables
.env
.env.*
!.env.example
